<!-- TOTP 算法实现：原 index.html 中的外链脚本，现已移入 public/ -->
<!-- is:inline 必需：指向 public/ 的资源不加此指令会被 Vite 当作待打包资源而报错 -->
<script is:inline src="/generate-totp.js"></script>

<script is:inline>
(function () {
    /* ---------- reveal on scroll ---------- */
    if ('IntersectionObserver' in window) {
        var io = new IntersectionObserver(function (entries) {
            entries.forEach(function (en) {
                if (en.isIntersecting) {
                    en.target.classList.add('is-visible');
                    io.unobserve(en.target);
                }
            });
        }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
        document.querySelectorAll('.reveal').forEach(function (el) { io.observe(el); });
    } else {
        document.querySelectorAll('.reveal').forEach(function (el) { el.classList.add('is-visible'); });
    }

    /* ---------- glass-card open ---------- */
    function openCardHref(href) {
        if (!href) return;
        window.open(href, '_blank', 'noopener');
    }
    document.querySelectorAll('.glass-card[data-href]').forEach(function (card) {
        card.addEventListener('click', function (e) {
            var btn = e.target.closest('.action-btn');
            if (btn) {
                e.stopPropagation();
                openCardHref(card.getAttribute('data-href'));
                return;
            }
            openCardHref(card.getAttribute('data-href'));
        });
        card.addEventListener('keydown', function (e) {
            if (e.key === 'Enter' || e.key === ' ') {
                e.preventDefault();
                openCardHref(card.getAttribute('data-href'));
            }
        });
    });

    /* ---------- top-bar scrolled ---------- */
    var topBar = document.getElementById('topBar');
    function onScroll() {
        if (window.scrollY > 40) topBar.classList.add('scrolled');
        else topBar.classList.remove('scrolled');
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    /* ---------- logo 回顶 ---------- */
    var logoWrap = document.getElementById('logoWrap');
    if (logoWrap) {
        logoWrap.addEventListener('click', function () {
            window.scrollTo({ top: 0, behavior: 'smooth' });
        });
    }

    /* ---------- menu active + smooth scroll ---------- */
    var menuItems = document.querySelectorAll('.menu ul li');
    menuItems.forEach(function (li) {
        li.addEventListener('click', function (e) {
            var a = li.querySelector('a');
            var href = a ? a.getAttribute('href') : '';
            if (href && href.charAt(0) === '#') {
                e.preventDefault();
                var target = document.querySelector(href);
                if (target) target.scrollIntoView({ behavior: 'smooth' });
            }
            menuItems.forEach(function (x) { x.classList.remove('active'); });
            li.classList.add('active');
        });
    });

    /* scroll spy */
    var sections = ['home', 'projects', 'articles'].map(function (id) {
        return document.getElementById(id);
    }).filter(Boolean);

    function spy() {
        var y = window.scrollY + 160;
        var current = 0;
        sections.forEach(function (sec, i) {
            if (sec.offsetTop <= y) current = i;
        });
        menuItems.forEach(function (li, i) {
            if (i < 3) li.classList.toggle('active', i === current);
        });
    }
    window.addEventListener('scroll', spy, { passive: true });

    /* ---------- banner carousel ---------- */
    var track = document.getElementById('bannerTrack');
    var indicators = document.querySelectorAll('#bannerIndicators .indicator');
    var prevBtn = document.getElementById('bannerPrev');
    var nextBtn = document.getElementById('bannerNext');
    var carousel = document.getElementById('bannerCarousel');
    var slideCount = track ? track.children.length : 0;
    var currentSlide = 0;
    var autoTimer = null;

    function goTo(index) {
        if (!track || slideCount === 0) return;
        currentSlide = ((index % slideCount) + slideCount) % slideCount;
        track.style.transform = 'translateX(-' + (currentSlide * 100) + '%)';
        indicators.forEach(function (dot, i) {
            dot.classList.toggle('active', i === currentSlide);
        });
    }

    function showArrows(show) {
        if (prevBtn) prevBtn.classList.toggle('visible', show);
        if (nextBtn) nextBtn.classList.toggle('visible', show);
    }

    if (carousel) {
        carousel.addEventListener('mouseenter', function () { showArrows(true); stopAuto(); });
        carousel.addEventListener('mouseleave', function () { showArrows(false); startAuto(); });
    }

    if (prevBtn) prevBtn.addEventListener('click', function () { goTo(currentSlide - 1); });
    if (nextBtn) nextBtn.addEventListener('click', function () { goTo(currentSlide + 1); });

    indicators.forEach(function (dot) {
        dot.addEventListener('click', function () {
            goTo(parseInt(dot.getAttribute('data-index'), 10) || 0);
        });
    });

    function startAuto() {
        stopAuto();
        if (slideCount > 1) autoTimer = setInterval(function () { goTo(currentSlide + 1); }, 5000);
    }
    function stopAuto() {
        if (autoTimer) { clearInterval(autoTimer); autoTimer = null; }
    }
    startAuto();

    /* ---------- avatar easter egg ---------- */
    var avatar = document.querySelector('.avatar');
    if (avatar) {
        avatar.addEventListener('click', function () {
            var messages = ["🎉 被你发现啦！", "👋 你好呀～", "⭐ 谢谢你来看我", "💻 一起加油！", "🌟 愿你今天开心", "🔮 这是一个隐藏彩蛋！", "💖 你点击了我的头像~"];
            alert(messages[Math.floor(Math.random() * messages.length)]);
        });
    }

    /* ---------- news list (active + preview fade) ---------- */
    var newsItems = document.querySelectorAll('#newsList .news-item');
    var preview = document.getElementById('newsPreview');

    newsItems.forEach(function (item) {
        item.addEventListener('click', function () {
            if (item.classList.contains('active')) return;
            newsItems.forEach(function (x) { x.classList.remove('active'); });
            item.classList.add('active');

            if (!preview) return;
            var title = item.querySelector('.news-item-title');
            var date = item.querySelector('.news-item-date');
            preview.classList.remove('preview-shown');
            preview.classList.add('preview-fading');
            setTimeout(function () {
                var t = preview.querySelector('.news-preview-title');
                var d = preview.querySelector('.news-preview-date');
                var cover = preview.querySelector('.cover-placeholder span');
                if (t && title) t.textContent = title.textContent;
                if (d && date) d.textContent = date.textContent;
                if (cover && title) cover.textContent = title.textContent;
                preview.classList.remove('preview-fading');
                preview.classList.add('preview-shown');
            }, 350);
        });
    });

    /* ---------- float popup ---------- */
    var floatBtn = document.getElementById('floatingBtn');
    var floatPopup = document.getElementById('floatPopup');
    var floatClose = document.getElementById('floatClose');

    if (floatBtn && floatPopup) {
        floatBtn.addEventListener('click', function () {
            if (floatPopup.classList.contains('closing')) return;
            if (floatPopup.classList.contains('open')) {
                closeFloatPopup();
            } else {
                floatPopup.classList.remove('closing');
                floatPopup.classList.add('open');
                floatBtn.classList.add('floating-btn--active');
            }
        });
    }

    function closeFloatPopup() {
        if (!floatPopup || !floatPopup.classList.contains('open')) return;
        floatPopup.classList.remove('open');
        floatPopup.classList.add('closing');
        if (floatBtn) floatBtn.classList.remove('floating-btn--active');
        var onEnd = function (e) {
            if (e.animationName && e.animationName !== 'popup-out') return;
            floatPopup.classList.remove('closing');
            floatPopup.removeEventListener('animationend', onEnd);
        };
        floatPopup.addEventListener('animationend', onEnd);
    }

    if (floatClose && floatPopup) {
        floatClose.addEventListener('click', closeFloatPopup);
    }

    /* ---------- TOTP ---------- */
    var TOTP_SECRET = "LSESKCQWEFSPPMZQ";
    var TOTP_CONFIGS = [
        { period: 30, digits: 6 },
        { period: 3600, digits: 6 }
    ];

    function formatCode(code) {
        return code.slice(0, 3) + ' ' + code.slice(3);
    }

    function formatTime(remainingSec) {
        var total = Math.floor(remainingSec);
        var hh = Math.floor(total / 3600);
        var mm = Math.floor((total % 3600) / 60);
        var ss = total % 60;
        var pad = function (n) { return n < 10 ? '0' + n : String(n); };
        if (hh > 0) return pad(hh) + ':' + pad(mm) + ':' + pad(ss);
        return pad(mm) + ':' + pad(ss);
    }

    function updateTOTP() {
        var now = Date.now() / 1000;
        var cards = document.querySelectorAll('.totp-card');
        cards.forEach(function (card, i) {
            var cfg = TOTP_CONFIGS[i];
            if (!cfg) return;
            var code = generateTOTP(TOTP_SECRET, { time: now, period: cfg.period, digits: cfg.digits });
            card.querySelector('[data-totp]').textContent = formatCode(code);
            var remaining = cfg.period - (now % cfg.period);
            card.querySelector('[data-expire]').textContent = formatTime(remaining);
            var pct = (remaining / cfg.period) * 100;
            card.querySelector('.totp-bar > i').style.width = pct.toFixed(1) + '%';
        });
    }

    updateTOTP();
    setInterval(updateTOTP, 50);

    document.querySelectorAll('.totp-card').forEach(function (card) {
        var btn = card.querySelector('.totp-copy-btn');
        if (!btn) return;
        var textEl = btn.querySelector('.totp-copy-text');
        var iconEl = btn.querySelector('i');
        var originalText = textEl ? textEl.textContent : '复制';
        var originalIcon = iconEl ? iconEl.className : '';

        btn.addEventListener('click', function () {
            var codeEl = card.querySelector('[data-totp]');
            if (!codeEl) return;
            var code = codeEl.textContent.replace(/\s+/g, '');
            navigator.clipboard.writeText(code).then(function () {
                btn.classList.add('is-copied');
                if (textEl) textEl.textContent = '已复制';
                if (iconEl) iconEl.className = 'fas fa-check';
                setTimeout(function () {
                    btn.classList.remove('is-copied');
                    if (textEl) textEl.textContent = originalText;
                    if (iconEl) iconEl.className = originalIcon;
                }, 1500);
            });
        });
    });
})();
</script>

</HomeLayout>
